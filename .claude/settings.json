{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"C:/dev.local/mcp-servers/languagetool-mcp-server\" && npm run typecheck 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}